# Dependencies (Node is a local dev-time tool only; the built CSS is committed)
node_modules/
**/node_modules/

# OS cruft
.DS_Store
**/.DS_Store

# Logs
*.log
npm-debug.log*

# Lighthouse reports (generated locally, not committed)
.lighthouse/

# Claude Code harness (local tooling, not part of the published site)
.claude/

# Internal build artifacts (kept out of the public repo)
speak-sustainability-claude-code-prompt.md
speak-sustainability-mockup-v1.png
# Root-level duplicate source assets — the served copies live in assets/
/hero-woman-340.webp
/hero-woman-680.webp

# Claude Code personal overrides (committed harness lives in .claude/settings.json)
.claude/settings.local.json

# Backend secrets (DATABASE_URL, RESEND_API_KEY, CONFIRM_TOKEN_SECRET, ...) —
# real values live in the hosting platform's env var UI, never in the repo.
# .env.example is the committed template and stays tracked.
.env
.env.local
.env*.local
.env*
!.env.example
.vercel
