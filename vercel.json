{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/access/:token", "destination": "/api/access?t=:token" }
  ],
  "functions": {
    "api/access.js": {
      "includeFiles": "install.html"
    }
  },
  "crons": [
    { "path": "/api/purge-unconfirmed", "schedule": "0 3 * * *" },
    { "path": "/api/purge-access-logs", "schedule": "0 4 * * *" }
  ]
}
