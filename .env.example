# Speak Sustainability — signup/confirm backend env vars.
# Copy to .env for local dev (git-ignored); set the real values in the
# hosting platform's env var UI (Vercel), never commit real secrets here.

# --- Database (new, dedicated Supabase Postgres project — NOT change-agent-app) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used only for `prisma migrate` (deploy/dev).
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Token signing ---
# Long random secret (e.g. `openssl rand -hex 32`) used to HMAC-sign confirm
# links. Rotating it invalidates all outstanding, unclicked confirm links.
CONFIRM_TOKEN_SECRET=""

# --- Abuse-signal hashing ---
# Long random salt (e.g. `openssl rand -hex 32`) for hashing IPs before
# storage (source_ip_hash / confirm_ip_hash) — never store raw IPs.
IP_HASH_SALT=""

# --- Email (Resend, Decided Q3) ---
RESEND_API_KEY=""
# Must be on a domain with SPF/DKIM/DMARC verified in Resend (FR-4.3).
RESEND_FROM_EMAIL="hello@speaksustainability.org"

# --- Site ---
# Used to build absolute links in emails (confirm URL, privacy notice URL).
PUBLIC_SITE_URL="https://speaksustainability.org"

# --- Scheduled purge job (api/purge-unconfirmed.js — stubbed, not yet scheduled) ---
PURGE_JOB_SECRET=""
