# Speak Sustainability — signup/confirm backend env vars.
# Copy to .env for local dev (git-ignored); set the real values in the
# hosting platform's env var UI (Vercel), never commit real secrets here.

# --- Database (new, dedicated Supabase Postgres project — NOT change-agent-app) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used only for `prisma migrate` (deploy/dev).
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Token signing ---
# Long random secret (e.g. `openssl rand -hex 32`) used to HMAC-sign confirm
# links. Rotating it invalidates all outstanding, unclicked confirm links.
CONFIRM_TOKEN_SECRET=""

# --- Abuse-signal hashing ---
# Long random salt (e.g. `openssl rand -hex 32`) for hashing IPs before
# storage (source_ip_hash / confirm_ip_hash) — never store raw IPs.
IP_HASH_SALT=""

# --- Approval (FR-3.3) ---
# Auto-approve on confirmation, no manual review — true for Alpha/Climate
# Week (Decided, Q1). Set to "false" to require manual review later; any
# other value (including unset) keeps auto-approve on.
AUTO_APPROVE_CONTACTS="true"

# --- Email (Resend, Decided Q3) ---
RESEND_API_KEY=""
# Must be on a domain with SPF/DKIM/DMARC verified in Resend (FR-4.3).
RESEND_FROM_EMAIL="hello@speaksustainability.org"

# --- Site ---
# Used to build absolute links in emails (confirm URL, privacy notice URL).
PUBLIC_SITE_URL="https://speaksustainability.org"

# --- Scheduled purge jobs (api/purge-unconfirmed.js, api/purge-access-logs.js) ---
# Both jobs are scheduled by the `crons` array in vercel.json and accept
# EITHER credential below (see lib/cronAuth.js).
#
# CRON_SECRET is how Vercel Cron authenticates. It is a normal env var you
# create yourself in Vercel (16+ random chars, e.g. `openssl rand -hex 32`) —
# Vercel does not populate it. Once set on the project, Vercel automatically
# sends its value as `Authorization: Bearer <CRON_SECRET>` on every scheduled
# GET. Must be set in Vercel Production for the crons to work at all; only
# needed locally if you're testing the endpoints by hand.
CRON_SECRET=""
# PURGE_JOB_SECRET is the manual/ops path — lets a human trigger a run on
# demand with `curl -X POST -H "x-purge-job-secret: ..."`, e.g. to service an
# erasure request without waiting for the nightly run.
PURGE_JOB_SECRET=""

# --- Package storage (Phase 3, FR-5.2/5.3) ---
# Private Vercel Blob store holding the skill's two package .zip variants.
# Auto-set by Vercel once a Blob store is created and linked to this project
# (vercel.com dashboard → Storage, or `vercel integration add blob`). Also
# needed locally to run `npm run skill:sync` (scripts/sync-skill-package.mjs).
BLOB_READ_WRITE_TOKEN=""
